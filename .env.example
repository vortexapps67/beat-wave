# ============================================================
# BeatWave Environment Variables Template (.env.example)
# Copy this file to .env and insert your real credentials
# ============================================================

# Admin Authentication
ADMIN_PASSWORD=your_admin_password_here

# Complete Firebase Configuration Object (JSON)
FIREBASE_CONFIGS='{"adminConfig":{"apiKey":"...","authDomain":"...","databaseURL":"...","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"..."},"playerConfig":{"apiKey":"...","authDomain":"...","databaseURL":"...","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"..."}}'

# Individual Admin Firebase App Credentials
FIREBASE_ADMIN_API_KEY=your_admin_api_key
FIREBASE_ADMIN_AUTH_DOMAIN=your_admin_auth_domain
FIREBASE_ADMIN_DATABASE_URL=https://your_admin_db.firebaseio.com
FIREBASE_ADMIN_PROJECT_ID=your_admin_project_id
FIREBASE_ADMIN_STORAGE_BUCKET=your_admin_storage_bucket
FIREBASE_ADMIN_MESSAGING_SENDER_ID=your_admin_messaging_sender_id
FIREBASE_ADMIN_APP_ID=your_admin_app_id
FIREBASE_ADMIN_MEASUREMENT_ID=your_admin_measurement_id

# Individual Player Firebase App Credentials
FIREBASE_PLAYER_API_KEY=your_player_api_key
FIREBASE_PLAYER_AUTH_DOMAIN=your_player_auth_domain
FIREBASE_PLAYER_DATABASE_URL=https://your_player_db.firebaseio.com
FIREBASE_PLAYER_PROJECT_ID=your_player_project_id
FIREBASE_PLAYER_STORAGE_BUCKET=your_player_storage_bucket
FIREBASE_PLAYER_MESSAGING_SENDER_ID=your_player_messaging_sender_id
FIREBASE_PLAYER_APP_ID=your_player_app_id
